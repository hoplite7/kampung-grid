# Copy this file to .env and fill in your key. NEVER commit .env.
# ANTHROPIC_API_KEY=replace-with-your-api-key
# Optional overrides
# KG_FAST_MODEL=claude-haiku-5-5
# KG_STRONG_MODEL=claude-sonnet-5-5
# KG_AI_TIMEOUT=8

# Crisis engine (Week 2)
# Seconds before an unanswered task moves to the next-best helper (simulated neighbours)
# KG_ESCALATE_SECONDS=90
# Same, for real phones in the demo (e.g. Aziz), so a slow tap doesn't spoil a rehearsal
# KG_FEATURED_ESCALATE_SECONDS=300
# Every start is a fresh demo. Set to false to keep data between restarts.
# KG_FRESH_ON_START=true
# Helpers whose phones are real in the demo (comma-separated ids); everyone else is simulated
# KG_FEATURED_HELPERS=aziz
# Let fictional neighbours respond on their own so the block comes alive
# KG_SIMULATE_NEIGHBOURS=true
# The demo's clock time, which decides which helpers are home
# KG_DEMO_TIME=21:00
# Simulated neighbours who never answer (so someone is still "not reached" when SCDF arrives). Empty = all answer.
# KG_SIM_NO_RESPONSE=nurul
# Residents no simulated neighbour reaches, so the SCDF brief always has someone NOT REACHED. Empty = all reached.
# KG_SIM_UNREACHED=rajan
# Voice notes (needs: pip install faster-whisper). small = faster, medium = better with Singlish
# KG_WHISPER_MODEL=small

# Telegram bot (optional): get a token from @BotFather in Telegram. Keep it secret like the API key.
# KG_TELEGRAM_TOKEN=replace-with-your-bot-token
# Helper roles judges can take when they scan the QR code
# KG_JOIN_ROLES=kavitha,benjamin,meiling,ryan
# Venue internet down? Answer only from saved Claude answers (rehearse once online first)
# KG_AI_OFFLINE=true
